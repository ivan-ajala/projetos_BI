            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>CONTEXTO</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#6b7280' fontname='Tableau Medium'>O processo mantém </run>
            <run bold='true' fontcolor='#6b7280' fontname='Tableau Medium'>alta taxa de aprovação</run>
            <run fontcolor='#6b7280' fontname='Tableau Medium'>, mas a pequena </run>
            <run bold='true' fontcolor='#6b7280' fontname='Tableau Medium'>fração de FAIL é crítica</run>
